# 应用
APP_NAME=健身瑜伽教培管理系统
APP_ENV=development
DEBUG=true

# 服务器
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=postgresql://fituser:fitpass123@postgres:5432/fit_saas
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# 密码
PASSWORD_SECRET_KEY=your-password-secret-key-change-in-production

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI (可选，Phase 2 启用)
AI_PROVIDER=
AI_API_KEY=

# Agent - 阿里云百炼 / 千问大模型 (Phase 3 - OPC改造)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-max
BAILIAN_APP_ID=

# Agent - 阿里云向量检索 (可选)
ALIYUN_VECTOR_API_KEY=
ALIYUN_VECTOR_ENDPOINT=
ALIYUN_VECTOR_NAMESPACE=fitai
ALIYUN_VECTOR_COLLECTION=member_memory

# Agent配置
AGENT_MAX_ITERATIONS=8
AGENT_REFLECTION_ENABLED=true
AGENT_TEMPERATURE=0.7